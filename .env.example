# Copy missing settings into airflow/.env, which is ignored by Git.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=DBT_ROLE
SNOWFLAKE_DATABASE=SWIGGY
SNOWFLAKE_WAREHOUSE=SWIGGY_WH
SNOWFLAKE_KEY_DIR=C:/Users/your-user/.dbt/keys
DBT_SNOWFLAKE_KEY_PASSPHRASE=
SWIGGY_RAW_STAGE=SWIGGY.RAW.SWIGGY_LOCAL_STAGE
# Optional existing external stages. Both are checked and loaded if configured.
SWIGGY_S3_STAGE=
SWIGGY_ADLS_STAGE=
SWIGGY_SCHEDULE=@daily
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
AI_BATCH_SIZE=8
AI_RECORD_LIMIT=20
GROQ_MIN_REQUEST_INTERVAL_SECONDS=3
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
APP_API_TOKEN=
FRESHNESS_MAX_AGE_SECONDS=172800
SOURCE_MAX_AGE_HOURS=0
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_REFRESH_TIMEOUT=1800
PIPELINE_FAILURE_WEBHOOK=
# Generate these with scripts/setup_airflow.py, preserving existing values.
AIRFLOW_JWT_SECRET=
AIRFLOW_FERNET_KEY=
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_UI_PORT=8081
